# Copy to .env for your own machine. On the server these go in /etc/club.env.
DATABASE_URL=sqlite:///./club.db
# dev shows sign-in codes on screen and the API docs; production hides both
CLUB_ENV=dev
CLUB_BASE_URL=http://localhost:8000
# sandbox writes every email to the email log only; smtp sends for real (see docs/EMAIL-JOBS-PAYMENTS.md)
CLUB_EMAIL_PROVIDER=sandbox
CLUB_EMAIL_FROM=Margate Yacht Club <office@example.org>
# off | sandbox (demos only) | live
CLUB_ONLINE_PAYMENTS=off
# Stripe takes card and Bacs Direct Debit (see docs/EMAIL-JOBS-PAYMENTS.md)
# CLUB_STRIPE_SECRET_KEY=sk_test_...
# CLUB_STRIPE_WEBHOOK_SECRET=whsec_...
# CLUB_DIRECT_DEBIT=stripe
# Read-only feeds for the committee's Sheet and the website: client:secret pairs (see app/feeds.py)
# CLUB_FEED_KEYS=sheet:change-me-to-a-long-random-secret,website:another-long-random-secret
